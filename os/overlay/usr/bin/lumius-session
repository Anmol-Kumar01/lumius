#!/bin/sh
# A separate user service owns restart/recovery. Native Plasma remains available.
if [ ! -d /run/live/medium/live ] && [ -n "${HOME:-}" ] && [ "$HOME" != / ]; then
    rm -f -- "$HOME/Desktop/lumius-installer.desktop"
fi
systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS
systemctl --user start lumius-shell.service
